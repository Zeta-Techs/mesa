{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "file-viewer",
  "description": "独立文件查看窗口（file_window.rs 建窗）：文件预览、编辑保存、外部打开与关闭确认",
  "windows": ["file-viewer"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "core:window:allow-title",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "dialog:default"
  ]
}
